<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aion2Meter.Core\Aion2Meter.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Raw socket (SIO_RCVALL) só funciona elevado: o Windows pede UAC ao abrir. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\dados\skills.json" Link="dados\skills.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\dados\skills.json')" />
  </ItemGroup>

</Project>
